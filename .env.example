DATABASE_URL="postgresql://doodle:doodle@localhost:5432/doodle_dash?schema=public"
STRICT_CHARACTER_LOCK=true
LOCK_STYLE_BIBLE=false
NEXT_PUBLIC_APP_NAME="Doodle Dash TV Studio"

# --- Cloud production engine (optional; defaults keep cloud OFF) ---
# CLOUD_RENDER_ENABLED=false
# ALLOW_PAID_GPU_LAUNCH=false
# MAX_GPU_HOURLY_PRICE=0.80
# MAX_SINGLE_JOB_COST=2.00
# MAX_DAILY_GPU_COST=10.00
# MAX_MONTHLY_GPU_COST=50.00
# IDLE_SHUTDOWN_MINUTES=5
# MAX_JOB_RUNTIME_MINUTES=180

# Cloudflare R2 (S3-compatible). Never commit real values.
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Or use OBJECT_STORAGE_PROVIDER=r2 with OBJECT_STORAGE_* vars.

# Runpod (server-side only). Never commit real values. Auth tests are non-billable.
# RUNPOD_API_KEY=

# TivvleJoy voice generation. Defaults keep ElevenLabs OFF.
# ALLOW_PAID_VOICE_GENERATION=false
# TIVVLEJOY_VOICE_AUTHORIZE_PAID=
# ELEVENLABS_API_KEY is server-side only. Never set NEXT_PUBLIC_ELEVENLABS_API_KEY.
# Never commit the key. Preview and tests use fixtures until Justin authorizes paid use.
# VOICE_GENERATION_MAX_CHARS_PER_REQUEST=280
# VOICE_GENERATION_MAX_CHARS_PER_EPISODE=2000
# VOICE_GENERATION_MONTHLY_CHAR_LIMIT=20000
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Published Runpod GPU worker image (workers/runpod-blender/Dockerfile), hosted
# on GHCR. NOT a secret. MUST be pinned by an immutable @sha256 digest — mutable
# tags such as :latest are rejected by the fail-closed image gate. A paid pod
# boots exactly these bytes.
# Immutable, digest-pinned Runpod GPU worker image (non-secret). Consumed by the
# paid-launch image gate; paid launch also requires ALLOW_PAID_GPU_LAUNCH=true.
# The ghcr.io org segment of this PUBLIC, non-secret image path coincidentally
# equals the configured R2 bucket name, so the secret scanner flags the line;
# the value below is a public image reference (anonymous pull verified), not a
# credential. Inline pragma is stripped by bash/dotenv loaders.
RUNPOD_WORKER_IMAGE=ghcr.io/doodledashtv/ddp-runpod-blender@sha256:e80cf523b7cb6d6c3a7c8dedda22e90ca0b8664f65be4c55eb82323083b31c27 # pragma: allowlist secret

