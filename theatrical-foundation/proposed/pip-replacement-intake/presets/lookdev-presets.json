{
  "schema": "tivvlejoy.lookdev_presets.v1",
  "destructive": false,
  "appliesToOriginalMeshes": false,
  "characterDependentFinalFraming": false,
  "colorManagement": {
    "viewTransform": "Khronos PBR Neutral",
    "look": "None",
    "exposure": 0.0,
    "gamma": 1.0,
    "displayDevice": "sRGB"
  },
  "render": {
