// ---------------------------------------------------------------------------
// DDP Steps 1-8 — direction layer persistence.
//
// Purely additive: two new tables, no column on an existing table changed or
// dropped, so an existing database migrates forward without touching a single
// historical row and a rollback is a DROP TABLE of things nothing else references.
// ---------------------------------------------------------------------------

/// A stored production blueprint. `content` is the deterministic document whose
/// hash is `contentHash`; `meta` holds the non-deterministic envelope and is never
/// hashed. Versioned by `schemaVersion` so `upgradeBlueprint()` can migrate it.
model ProductionBlueprintRecord {
  id             String   @id @default(uuid()) @db.Uuid
  /// Logical episode identifier from the approved scene plan, not an Episode row id:
  /// planning precedes production, so this cannot be a foreign key.
  episodeId      String   @map("episode_id")
  schemaVersion  String   @map("schema_version")
  /// Content hash. Two rows with the same hash describe the same episode exactly.
  contentHash    String   @map("content_hash")
  cacheKey       String   @map("cache_key")
  seed           String
  status         String   @default("DRAFT")
  validationStatus String @default("PASS") @map("validation_status")
  errorCount     Int      @default(0) @map("error_count")
  warningCount   Int      @default(0) @map("warning_count")
  shotCount      Int      @default(0) @map("shot_count")
  durationSeconds Float   @default(0) @map("duration_seconds")
  estimatedCloudCostUsd Float @default(0) @map("estimated_cloud_cost_usd")
  content        Json
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  overrides      DirectorOverrideRecord[]

  @@unique([episodeId, contentHash])
  @@index([episodeId, createdAt])
  @@map("production_blueprints")
}

/// A human override of one blueprint field, with provenance. Refused overrides are
/// stored too — `refusedBecause` non-null — because an attempt to loosen a
/// character lock is exactly the thing a reviewer needs to be able to see.
model DirectorOverrideRecord {
  id             String   @id @default(uuid()) @db.Uuid
  blueprintId    String?  @map("blueprint_id") @db.Uuid
  episodeId      String   @map("episode_id")
  /// Dot path into the blueprint content, e.g. `shots.0.lighting.recipe`.
  path           String
  fromValue      Json?    @map("from_value")
  toValue        Json?    @map("to_value")
  createdBy      String   @map("created_by")
  reason         String
  refusedBecause String?  @map("refused_because")
  createdAt      DateTime @default(now()) @map("created_at")

  blueprint      ProductionBlueprintRecord? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)

  @@index([episodeId, createdAt])
  @@index([blueprintId])
  @@map("director_overrides")
}

/// Character-independent pre-production run (Studio Milestone 5).
/// `episode_id` is TEXT, not a UUID foreign key — planning can precede an
/// Episode row, and proxy pipeline tests use logical ids such as
/// `M4_PROXY_PIPELINE_TEST`. Nothing here writes production-library.
model PreproductionRun {
  id                 String   @id @default(uuid()) @db.Uuid
  episodeId          String   @map("episode_id")
  schemaVersion      String   @map("schema_version")
  characterMode      String   @map("character_mode")
  outputClass        String   @map("output_class")
  terminalState      String   @map("terminal_state")
  status             String
  cacheKey           String   @map("cache_key")
  scenePlanEmitted   Boolean  @default(false) @map("scene_plan_emitted")
  paidGpu            Boolean  @default(false) @map("paid_gpu")
  content            Json
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([episodeId, cacheKey])
  @@index([episodeId, createdAt])
  @@map("preproduction_runs")
}

// ---------------------------------------------------------------------------
// TivvleJoy persistence foundation.
//
// Additive tables for a future production database and durable asset store.
// This increment does not connect DATABASE_URL, object storage, or a paid
// provider. Public Preview keeps using browser localStorage.
// ---------------------------------------------------------------------------

model TivvleJoyWorkspace {
  id                            String   @id @default(uuid()) @db.Uuid
  label                         String
  projectName                   String   @map("project_name")
  format                        String   @default("1080x1920")
  fps                           Int      @default(30)
  paidResourcesAuthorized       Boolean  @default(false) @map("paid_resources_authorized")
  theatricalBindingCompleted    Boolean  @default(false) @map("theatrical_binding_completed")
  durable                       Boolean  @default(false)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  productions TivvleJoyProduction[]
  auditEvents TivvleJoyAuditEvent[]

  @@map("tivvlejoy_workspaces")
}

model TivvleJoyProduction {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  status      String   @default("DRAFT")
  durable     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace       TivvleJoyWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  episodes        TivvleJoyEpisode[]
  assets          TivvleJoyAsset[]
  voices          TivvleJoyVoiceProfile[]
  readiness       TivvleJoyReadinessResult[]
  renderRequests  TivvleJoyRenderRequest[]
  voiceLines      TivvleJoyVoiceLine[]

  @@index([workspaceId, createdAt])
  @@map("tivvlejoy_productions")
}

model TivvleJoyEpisode {
  id              String   @id @default(uuid()) @db.Uuid
  productionId    String   @map("production_id") @db.Uuid
  title           String
  episodeNumber   Int      @map("episode_number")
  durationSec     Int      @map("duration_sec")
  premise         String
  classification  String   @default("PREVIEW_NONCANONICAL")
  currentStage    String   @map("current_stage")
  completedStages Json     @map("completed_stages")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  production TivvleJoyProduction      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  workflow   TivvleJoyWorkflowStatus?

  @@index([productionId, episodeNumber])
  @@map("tivvlejoy_episodes")
}

model TivvleJoyAsset {
  id             String   @id @default(uuid()) @db.Uuid
  productionId   String   @map("production_id") @db.Uuid
  name           String
  type           String
  version        String
  status         String   @default("REGISTERED_METADATA_ONLY")
  classification String   @default("PREVIEW_NONCANONICAL")
  canonical      Boolean  @default(false)
  objectKey      String?  @map("object_key")
  contentType    String?  @map("content_type")
  byteSize       Int?     @map("byte_size")
  notes          String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  production TivvleJoyProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([productionId, createdAt])
  @@map("tivvlejoy_assets")
}

model TivvleJoyVoiceProfile {
  id                           String    @id @default(uuid()) @db.Uuid
  productionId                 String    @map("production_id") @db.Uuid
  characterLabel               String    @map("character_label")
