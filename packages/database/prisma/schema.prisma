generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniverseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CanonLevel {
  IMMUTABLE
  CURRENT
  HISTORICAL
}

enum CanonSubjectType {
  UNIVERSE
  CHARACTER
  LOCATION
  PROP
  EPISODE
  SEASON
  GENERAL
}

enum CharacterStatus {
  PROPOSED
  DESIGN
  ACTIVE
  RETIRED
  ARCHIVED
}

enum CharacterModelStatus {
  MISSING
  MODELING
  TEXTURING
  RIGGING
  FACIAL_RIGGING
  REVIEW
  APPROVED
  PRODUCTION_READY
}

enum AssetType {
  CHARACTER_MODEL
  RIG
  FACIAL_RIG
  ANIMATION
  POSE
  EXPRESSION
  LOCATION
  PROP
  MATERIAL
  TEXTURE
  LIGHTING_RIG
  CAMERA
  VFX
  AUDIO
  MUSIC
  SFX
  STORYBOARD
  VIDEO
  FINAL_EPISODE
  THUMBNAIL
  REFERENCE_IMAGE
  OTHER
}

enum AnimationCategory {
  LOCOMOTION
  DIALOGUE
  REACTION
  INTERACTION
  EMOTIONAL
  IDLE
}

enum ReferenceReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CONFLICTING
}

enum RegistryApprovalStatus {
  MISSING
  DRAFT
  REVIEW
  APPROVED
  REJECTED
}

model Universe {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  brandName            String         @map("brand_name")
  description          String?
  targetAudience       String?        @map("target_audience")
  worldDescription     String?        @map("world_description")
  visualStyleId        String?        @map("visual_style_id") @db.Uuid
  defaultOutputFormat  String         @default("1080x1920") @map("default_output_format")
  status               UniverseStatus @default(ACTIVE)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  characters       Character[]
  canonFacts       CanonFact[]
  assets           Asset[]
  animations       AnimationDefinition[]
  poses            PoseDefinition[]
  expressions      ExpressionDefinition[]
  referenceImages  CharacterReferenceImage[]
  relationships    CharacterRelationship[]
  locations        Location[]
  props            Prop[]
  seasons          Season[]
  episodes         Episode[]
  storyThreads     StoryThread[]
  foreshadowings   Foreshadowing[]
  episodeMemories  EpisodeMemory[]
  styleBibles      StyleBible[]
  materials        MaterialPreset[]
  lightingPresets  LightingPreset[]
  cameraPresets    CameraPreset[]
  vfxPresets       VfxPreset[]
  assetRequests    AssetRequest[]
  voiceProfiles    VoiceProfile[]
  soundClips       SoundClip[]
  musicTracks      MusicTrack[]
  publishingReleases PublishingRelease[]
  costLedgerEntries CostLedgerEntry[]
  analyticsMetrics AnalyticsMetric[]

  @@map("universes")
}

model CanonFact {
  id                   String           @id @default(uuid()) @db.Uuid
  universeId           String           @map("universe_id") @db.Uuid
  subjectType          CanonSubjectType @map("subject_type")
  subjectId            String?          @map("subject_id") @db.Uuid
  category             String
  statement            String
  canonLevel           CanonLevel       @default(CURRENT) @map("canon_level")
  importance           Int              @default(50)
  locked               Boolean          @default(false)
  introducedEpisodeId  String?          @map("introduced_episode_id") @db.Uuid
  effectiveEpisodeId   String?          @map("effective_episode_id") @db.Uuid
  retiredEpisodeId     String?          @map("retired_episode_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([subjectType, subjectId])
  @@map("canon_facts")
}

model Character {
  id               String          @id @default(uuid()) @db.Uuid
  universeId       String          @map("universe_id") @db.Uuid
  internalCode     String          @unique @map("internal_code")
  name             String
  nickname         String?
  species          String?
  role             String?
  ageRange         String?         @map("age_range")
  biography        String?
  personality      String?
  strengths        String?
  weaknesses       String?
  fears            String?
  motivations      String?
  goals            String?
  habits           String?
  likes            String?
  dislikes         String?
  catchphrases     String?
  speechStyle      String?         @map("speech_style")
  comedyStyle      String?         @map("comedy_style")
  movementStyle    String?         @map("movement_style")
  foundingCharacter Boolean        @default(false) @map("founding_character")
  status           CharacterStatus @default(ACTIVE)
  firstEpisodeId   String?         @map("first_episode_id") @db.Uuid
  currentVersionId String?         @map("current_version_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  universe        Universe                 @relation(fields: [universeId], references: [id], onDelete: Cascade)
  versions        CharacterVersion[]
  models          Character3dModel[]
  rigs            CharacterRig[]
  facialRigs      CharacterFacialRig[]
  referenceImages CharacterReferenceImage[]
  visualDna       CharacterVisualDna?
  personalityDna  CharacterPersonalityDna?
  motionDna       CharacterMotionDna?
  voiceDna        CharacterVoiceDna?
  storyDna        CharacterStoryDna?
  development     CharacterDevelopment?
  developmentEvents CharacterDevelopmentEvent[]
  relationshipsFrom CharacterRelationship[] @relation("RelationshipFrom")
  relationshipsTo   CharacterRelationship[] @relation("RelationshipTo")

  @@index([universeId])
  @@map("characters")
}

model CharacterVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  characterId          String   @map("character_id") @db.Uuid
  versionNumber        Int      @map("version_number")
  versionName          String   @map("version_name")
  changeSummary        String?  @map("change_summary")
  activeFromEpisodeId  String?  @map("active_from_episode_id") @db.Uuid
  activeUntilEpisodeId String?  @map("active_until_episode_id") @db.Uuid
  approved             Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")

  character       Character                 @relation(fields: [characterId], references: [id], onDelete: Cascade)
  models          Character3dModel[]
  rigs            CharacterRig[]
  facialRigs      CharacterFacialRig[]
  referenceImages CharacterReferenceImage[]

  @@unique([characterId, versionNumber])
  @@map("character_versions")
}

model CharacterVisualDna {
  id                 String   @id @default(uuid()) @db.Uuid
  characterId        String   @unique @map("character_id") @db.Uuid
  bodyProportions    String?  @map("body_proportions")
  headRatio          String?  @map("head_ratio")
  faceShape          String?  @map("face_shape")
  eyeDesign          String?  @map("eye_design")
  bodyColoration     String?  @map("body_coloration")
  furFeatherDetails  String?  @map("fur_feather_details")
  clothing           String?
  accessories        String?
  silhouette         String?
  palette            String?
  materials          String?
  textures           String?
  visualRestrictions String?  @map("visual_restrictions")
  pendingReview      Boolean  @default(true) @map("pending_review")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_visual_dna")
}

model CharacterPersonalityDna {
  id             String   @id @default(uuid()) @db.Uuid
  characterId    String   @unique @map("character_id") @db.Uuid
  friendliness   Int      @default(50)
  confidence     Int      @default(50)
  bravery        Int      @default(50)
  curiosity      Int      @default(50)
  patience       Int      @default(50)
  energy         Int      @default(50)
  empathy        Int      @default(50)
  leadership     Int      @default(50)
  independence   Int      @default(50)
  impulsiveness  Int      @default(50)
  humor          Int      @default(50)
  temperament    String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_personality_dna")
}

model CharacterMotionDna {
  id             String   @id @default(uuid()) @db.Uuid
  characterId    String   @unique @map("character_id") @db.Uuid
  walk           String?
  run            String?
  jump           String?
  idle           String?
  turn           String?
  gestureStyle   String?  @map("gesture_style")
  reactionStyle  String?  @map("reaction_style")
  happyMotion    String?  @map("happy_motion")
  sadMotion      String?  @map("sad_motion")
  fearMotion     String?  @map("fear_motion")
  excitedMotion  String?  @map("excited_motion")
  angryMotion    String?  @map("angry_motion")
  pendingReview  Boolean  @default(true) @map("pending_review")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_motion_dna")
}

model CharacterVoiceDna {
  id              String   @id @default(uuid()) @db.Uuid
  characterId     String   @unique @map("character_id") @db.Uuid
  voiceProfile    String?  @map("voice_profile")
  pitch           String?
  cadence         String?
  speed           String?
  energy          String?
  vocabulary      String?
  pronunciation   String?
  emotionalRange  String?  @map("emotional_range")
  providerType    String?  @map("provider_type")
  providerVoiceId String?  @map("provider_voice_id")
  pendingReview   Boolean  @default(true) @map("pending_review")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_voice_dna")
}

model CharacterStoryDna {
  id               String   @id @default(uuid()) @db.Uuid
  characterId      String   @unique @map("character_id") @db.Uuid
  coreDesire       String?  @map("core_desire")
  mainFear         String?  @map("main_fear")
  longTermGoal     String?  @map("long_term_goal")
  growthDirection  String?  @map("growth_direction")
  weakness         String?
  lesson           String?
  conflicts        String?
  importantRelationships String? @map("important_relationships")
  pendingReview    Boolean  @default(true) @map("pending_review")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_story_dna")
}

model Character3dModel {
  id                  String               @id @default(uuid()) @db.Uuid
  characterId         String               @map("character_id") @db.Uuid
  characterVersionId  String?              @map("character_version_id") @db.Uuid
  modelName           String               @map("model_name")
  masterBlendAssetId  String?              @map("master_blend_asset_id") @db.Uuid
  fbxAssetId          String?              @map("fbx_asset_id") @db.Uuid
  gltfAssetId         String?              @map("gltf_asset_id") @db.Uuid
  textureSetId        String?              @map("texture_set_id") @db.Uuid
  rigId               String?              @map("rig_id") @db.Uuid
  facialRigId         String?              @map("facial_rig_id") @db.Uuid
  materialSetId       String?              @map("material_set_id") @db.Uuid
  scale               Float                @default(1.0)
  status              CharacterModelStatus @default(MISSING)
  approved            Boolean              @default(false)
  productionReady     Boolean              @default(false) @map("production_ready")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version   CharacterVersion? @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  rig       CharacterRig?     @relation(fields: [rigId], references: [id], onDelete: SetNull)
  facialRig CharacterFacialRig? @relation(fields: [facialRigId], references: [id], onDelete: SetNull)

  @@index([characterId])
  @@index([status])
  @@map("character_3d_models")
}

model CharacterRig {
  id                   String                 @id @default(uuid()) @db.Uuid
  characterId          String                 @map("character_id") @db.Uuid
  characterVersionId   String?                @map("character_version_id") @db.Uuid
  rigVersion           String                 @map("rig_version")
  skeletonType         String?                @map("skeleton_type")
  boneMap              Json?                  @map("bone_map")
  ikConfiguration      Json?                  @map("ik_configuration")
  controlRig           Json?                  @map("control_rig")
  supportsFeet         Boolean                @default(true) @map("supports_feet")
  supportsHands        Boolean                @default(true) @map("supports_hands")
  supportsHead         Boolean                @default(true) @map("supports_head")
  supportsEyes         Boolean                @default(true) @map("supports_eyes")
  supportsSpine        Boolean                @default(true) @map("supports_spine")
  supportsEars         Boolean                @default(false) @map("supports_ears")
  supportsTail         Boolean                @default(false) @map("supports_tail")
  assetId              String?                @map("asset_id") @db.Uuid
  status               RegistryApprovalStatus @default(MISSING)
  approved             Boolean                @default(false)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  character    Character                 @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version      CharacterVersion?         @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  models       Character3dModel[]
  compatibilities AnimationRigCompatibility[]

  @@index([characterId])
  @@map("character_rigs")
}

model CharacterFacialRig {
  id                 String                 @id @default(uuid()) @db.Uuid
  characterId        String                 @map("character_id") @db.Uuid
  characterVersionId String?                @map("character_version_id") @db.Uuid
  rigVersion         String                 @map("rig_version")
  shapeKeys          Json?                  @map("shape_keys")
  facialBones        Json?                  @map("facial_bones")
  visemes            Json?
  supportedExpressions Json?                @map("supported_expressions")
  assetId            String?                @map("asset_id") @db.Uuid
  status             RegistryApprovalStatus @default(MISSING)
  approved           Boolean                @default(false)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version   CharacterVersion? @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)
  models    Character3dModel[]

  @@index([characterId])
  @@map("character_facial_rigs")
}

model CharacterReferenceImage {
  id                 String                @id @default(uuid()) @db.Uuid
  universeId         String                @map("universe_id") @db.Uuid
  characterId        String                @map("character_id") @db.Uuid
  characterVersionId String?               @map("character_version_id") @db.Uuid
  assetId            String?               @map("asset_id") @db.Uuid
  title              String
  viewType           String?               @map("view_type")
  reviewStatus       ReferenceReviewStatus @default(PENDING_REVIEW) @map("review_status")
  isPrimary          Boolean               @default(false) @map("is_primary")
  notes              String?
  conflictGroup      String?               @map("conflict_group")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  universe  Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version   CharacterVersion? @relation(fields: [characterVersionId], references: [id], onDelete: SetNull)

  @@index([characterId])
  @@index([reviewStatus])
  @@map("character_reference_images")
}

model AnimationDefinition {
  id           String            @id @default(uuid()) @db.Uuid
  universeId   String            @map("universe_id") @db.Uuid
  code         String
  name         String
  category     AnimationCategory
  durationMs   Int?              @map("duration_ms")
  loopable     Boolean           @default(false)
  emotion      String?
  assetId      String?           @map("asset_id") @db.Uuid
  status       RegistryApprovalStatus @default(MISSING)
  approved     Boolean           @default(false)
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  universe        Universe                    @relation(fields: [universeId], references: [id], onDelete: Cascade)
  compatibilities AnimationRigCompatibility[]

  @@unique([universeId, code])
  @@index([category])
  @@map("animation_definitions")
}

model AnimationRigCompatibility {
  id           String @id @default(uuid()) @db.Uuid
  animationId  String @map("animation_id") @db.Uuid
  rigId        String @map("rig_id") @db.Uuid
  compatible   Boolean @default(true)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  animation AnimationDefinition @relation(fields: [animationId], references: [id], onDelete: Cascade)
  rig       CharacterRig        @relation(fields: [rigId], references: [id], onDelete: Cascade)

  @@unique([animationId, rigId])
  @@map("animation_rig_compatibilities")
}

model PoseDefinition {
  id         String                 @id @default(uuid()) @db.Uuid
  universeId String                 @map("universe_id") @db.Uuid
  code       String
  name       String
  category   String?
  assetId    String?                @map("asset_id") @db.Uuid
  status     RegistryApprovalStatus @default(MISSING)
  approved   Boolean                @default(false)
  notes      String?
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, code])
  @@map("pose_definitions")
}

model ExpressionDefinition {
  id         String                 @id @default(uuid()) @db.Uuid
  universeId String                 @map("universe_id") @db.Uuid
  code       String
  name       String
  intensity  String?
  assetId    String?                @map("asset_id") @db.Uuid
  status     RegistryApprovalStatus @default(MISSING)
  approved   Boolean                @default(false)
  notes      String?
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, code])
  @@map("expression_definitions")
}

model VisemeDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("viseme_definitions")
}

model StudioSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("studio_settings")
}

model CharacterDevelopment {
  id             String   @id @default(uuid()) @db.Uuid
  characterId    String   @unique @map("character_id") @db.Uuid
  confidence     Int      @default(50)
  courage        Int      @default(50)
  patience       Int      @default(50)
  empathy        Int      @default(50)
  leadership     Int      @default(50)
  independence   Int      @default(50)
  curiosity      Int      @default(50)
  responsibility Int      @default(50)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_development")
}

model CharacterDevelopmentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  characterId     String   @map("character_id") @db.Uuid
  attribute       String
  previousValue   Int      @map("previous_value")
  newValue        Int      @map("new_value")
  delta           Int
  storyEventRef   String   @map("story_event_ref")
  episodeId       String?  @map("episode_id") @db.Uuid
  summary         String?
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([storyEventRef])
  @@map("character_development_events")
}

model CharacterRelationship {
  id                 String   @id @default(uuid()) @db.Uuid
  universeId         String   @map("universe_id") @db.Uuid
  fromCharacterId    String   @map("from_character_id") @db.Uuid
  toCharacterId      String   @map("to_character_id") @db.Uuid
  trust              Int      @default(50)
  friendship         Int      @default(50)
  respect            Int      @default(50)
  dependence         Int      @default(50)
  tension            Int      @default(20)
  rivalry            Int      @default(10)
  familiarity        Int      @default(50)
  label              String?
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  fromCharacter Character @relation("RelationshipFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("RelationshipTo", fields: [toCharacterId], references: [id], onDelete: Cascade)
  universe      Universe  @relation(fields: [universeId], references: [id], onDelete: Cascade)
  events        RelationshipEvent[]

  @@unique([fromCharacterId, toCharacterId])
  @@index([universeId])
  @@map("character_relationships")
}

model RelationshipEvent {
  id              String   @id @default(uuid()) @db.Uuid
  relationshipId  String   @map("relationship_id") @db.Uuid
  attribute       String
  previousValue   Int      @map("previous_value")
  newValue        Int      @map("new_value")
  delta           Int
  storyEventRef   String   @map("story_event_ref")
  episodeId       String?  @map("episode_id") @db.Uuid
  summary         String?
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  relationship CharacterRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
  @@index([storyEventRef])
  @@map("relationship_events")
}

model Asset {
  id               String    @id @default(uuid()) @db.Uuid
  universeId       String?   @map("universe_id") @db.Uuid
  type             AssetType
  entityType       String?   @map("entity_type")
  entityId         String?   @map("entity_id") @db.Uuid
  name             String
  version          Int       @default(1)
  storageLocation  String?   @map("storage_location")
  mimeType         String?   @map("mime_type")
  dimensions       String?
  durationMs       Int?      @map("duration_ms")
  hash             String?
  approved         Boolean   @default(false)
  missing          Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  universe Universe? @relation(fields: [universeId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([entityType, entityId])
  @@map("assets")
}

// ============================================================
// Milestone 6+ — World, Story, Production, Render, Audio, Publish
// ============================================================

enum StoryWorkflowStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  LOCKED
}

enum ThreadStatus {
  OPEN
  PLANTED
  PAYING_OFF
  RESOLVED
  DROPPED
  PLANNED
  ACTIVE
  PAUSED
  ABANDONED
}

enum ForeshadowStatus {
  PLANNED
  PLANTED
  PAID_OFF
  RETIRED
}

enum PropCondition {
  NEW
  GOOD
  WORN
  DAMAGED
  LOST
  RESTORED
}

enum RenderJobStatus {
  QUEUED
  PREPARING
  RENDERING
  ENCODING
  QUALITY_CHECK
  COMPLETE
  FAILED
  CANCELLED
}

model Location {
  id                 String   @id @default(uuid()) @db.Uuid
  universeId         String   @map("universe_id") @db.Uuid
  internalCode       String   @map("internal_code")
  name               String
  description        String?
  environmentType    String?  @map("environment_type")
  lightingRules      String?  @map("lighting_rules")
  palette            String?
  landmarks          String?
  weatherRules       String?  @map("weather_rules")
  timeOfDayRules     String?  @map("time_of_day_rules")
  history            String?
