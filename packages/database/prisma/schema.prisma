model CharacterTimelineEvent {
  id            String   @id @default(uuid()) @db.Uuid
  characterId   String   @map("character_id") @db.Uuid
  storyEventRef String   @map("story_event_ref")
  title         String
  summary       String?
  episodeId     String?  @map("episode_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([characterId])
  @@map("character_timeline_events")
}
